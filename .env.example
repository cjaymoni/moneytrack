# Copy to .env and fill in. Nothing in this file is a real value, and no secret belongs in
# this repository — not in a default, not in a test fixture, not in a comment.

# Postgres. The local container `tools/pg.sh` starts listens on 55432.
DATABASE_URL=postgres://moneytrack:moneytrack@127.0.0.1:55432/moneytrack

# Where the API listens.
BIND=127.0.0.1:8080

# Session cookies carry `Secure` unless this says otherwise. Set it to false only for local
# development over plain HTTP, where a `Secure` cookie is never sent and nothing works.
SECURE_COOKIES=false
